VITE_DISCORD_CLIENT_ID=
# Must match an OAuth2 redirect URI configured in the Discord Developer Portal.
# The Discord Activity examples commonly use https://127.0.0.1 for Activity-only auth.
VITE_DISCORD_REDIRECT_URI=https://127.0.0.1
# Set to true only when you want to force Discord SDK initialization outside Discord's iframe detection.
VITE_DISCORD_ACTIVITY=false
